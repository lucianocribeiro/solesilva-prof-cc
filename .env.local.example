# Contraseña única de acceso a la app. Se compara solo en el servidor.
APP_PASSWORD=

# Clave para firmar la cookie de sesión (HMAC).
# Generala con: openssl rand -base64 32
SESSION_SECRET=

# Token de Airtable, de solo lectura y limitado a esta base.
# Scopes: data.records:read y schema.bases:read. Ver el README.
AIRTABLE_TOKEN=

# Id de la base. Sale de la URL: https://airtable.com/<AIRTABLE_BASE_ID>/...
AIRTABLE_BASE_ID=
